# Bloque de cuentitas en el Caddy compartido del VPS:
#   /opt/caddy/conf/Caddyfile
#
# El contenedor cuentitas-web-1 está en la red edge con Caddy, así que se lo
# alcanza por nombre de contenedor (no por localhost). Aplicar sin downtime:
#   docker exec caddy caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
#   docker exec caddy caddy reload   --config /etc/caddy/Caddyfile --adapter caddyfile

cuentitas.site {
    encode gzip
    reverse_proxy cuentitas-web-1:80
}
